{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YuyanYYt/Yuan_Scaffold/packages/workflow-contracts/schema/workflow-ir-v0.1.schema.json",
  "title": "Yuan Scaffold Canonical Workflow IR v0.1",
  "description": "Portable workflow declaration. Resource bindings express requested resources, never identity or authorization. The server must resolve bindings and reconcile tool effect, risk, and capabilities with authoritative catalogs before execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_id",
    "version",
    "status",
    "entry_node_id",
    "state_schema",
    "types",
    "bindings",
    "execution_policy",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "workflow_id": {
      "$ref": "#/$defs/identifier"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "status": {
      "description": "Exported lifecycle label only. The server's Release Catalog is authoritative; an imported IR cannot activate itself.",
      "enum": ["DRAFT", "TESTED", "ACTIVE", "RETIRED"]
    },
    "entry_node_id": {
      "$ref": "#/$defs/identifier"
    },
    "state_schema": {
      "description": "Standalone JSON Schema 2020-12 for the persisted LangGraph state. Compiled separately by the server.",
      "type": "object",
      "required": ["$schema", "type"],
      "properties": {
        "$schema": {
          "const": "https://json-schema.org/draft/2020-12/schema"
        },
        "type": {
          "const": "object"
        }
      }
    },
    "types": {
      "description": "Named JSON Schema 2020-12 payload types referenced by node ports using #/types/Name. Each type is compiled separately by the server.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "bindings": {
      "$ref": "#/$defs/bindings"
    },
    "execution_policy": {
      "$ref": "#/$defs/executionPolicy"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "extensions": {
      "description": "Namespaced, non-authoritative metadata. Extensions never override core execution or security fields.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_.-]*$"
      }
    },
    "ui_metadata": {
      "description": "Optional canvas coordinates, colors, and collapsed state. This object has no execution semantics and must be ignored by the compiler.",
      "type": "object"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:[.-][a-z0-9_]+)*$",
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "statePath": {
      "type": "string",
      "pattern": "^\\$\\.[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"
    },
    "resourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "resource_id", "version"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "resource_id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "toolBinding": {
      "description": "Effect, risk, and capability claims are untrusted declarations. The server must compare them with the authoritative Tool Catalog and fail closed on a mismatch.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "resource_id", "version", "effect", "risk", "required_capabilities"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "resource_id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "effect": {
          "enum": ["read", "write", "external"]
        },
        "risk": {
          "enum": ["low", "medium", "high", "critical"]
        },
        "required_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "indexBinding": {
      "description": "Build parameters are bound to an immutable index version. Query-time ef_search is configured on rag_retrieve nodes.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "resource_id", "version", "kind", "build_params"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "resource_id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "kind": {
          "const": "hnsw"
        },
        "build_params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["m", "ef_construction"],
          "properties": {
            "m": {
              "type": "integer",
              "minimum": 2
            },
            "ef_construction": {
              "type": "integer",
              "minimum": 2
            }
          }
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "models",
        "prompts",
        "knowledge_bases",
        "indexes",
        "tools",
        "subgraphs",
        "approval_policies"
      ],
      "properties": {
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceBinding"
          }
        },
        "prompts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceBinding"
          }
        },
        "knowledge_bases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceBinding"
          }
        },
        "indexes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/indexBinding"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/toolBinding"
          }
        },
        "subgraphs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceBinding"
          }
        },
        "approval_policies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceBinding"
          }
        }
      }
    },
    "executionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_steps", "max_duration_ms", "max_tool_calls", "max_model_tokens", "max_cost"],
      "properties": {
        "max_steps": {
          "type": "integer",
          "minimum": 1
        },
        "max_duration_ms": {
          "type": "integer",
          "minimum": 1
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "max_model_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amount_micro", "currency"],
          "properties": {
            "amount_micro": {
              "type": "integer",
              "minimum": 0
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          }
        }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "schema_ref"],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "schema_ref": {
          "type": "string",
          "pattern": "^#/types/[A-Z][A-Za-z0-9_]*$"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "type_version", "input_ports", "output_ports", "config"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "oneOf": [
            {
              "enum": [
                "chat_input",
                "auth_context",
                "rag_retrieve",
                "answer_with_citation",
                "answer_gate",
                "chat_output",
                "branch",
                "loop",
                "tool_call",
                "human_approval",
                "subgraph"
              ]
            },
            {
              "type": "string",
              "pattern": "^ext\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
            }
          ]
        },
        "type_version": {
          "$ref": "#/$defs/version"
        },
        "input_ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "output_ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "config": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "chat_input"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/chatInputConfig"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "auth_context"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/authContextConfig"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "rag_retrieve"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/ragRetrieveConfig"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "answer_with_citation"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/answerWithCitationConfig"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "answer_gate"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/answerGateConfig"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "chat_output"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/chatOutputConfig"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "branch"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/branchConfig"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "loop"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/loopConfig"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "tool_call"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/toolCallConfig"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "human_approval"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/humanApprovalConfig"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "subgraph"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/subgraphConfig"
              }
            }
          }
        }
      ]
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "port"],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/identifier"
        },
        "port": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "from": {
          "$ref": "#/$defs/endpoint"
        },
        "to": {
          "$ref": "#/$defs/endpoint"
        }
      }
    },
    "predicate": {
      "description": "Declarative, bounded comparison over workflow state; no executable code or identity-derived authorization decisions.",
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "state_path"],
      "properties": {
        "op": {
          "enum": ["eq", "ne", "gt", "gte", "lt", "lte", "in", "exists", "not_exists"]
        },
        "state_path": {
          "$ref": "#/$defs/statePath"
        },
        "value": {
          "oneOf": [
            {
              "type": ["string", "number", "boolean", "null"]
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": ["string", "number", "boolean", "null"]
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "enum": ["eq", "ne", "gt", "gte", "lt", "lte", "in"]
              }
            }
          },
          "then": {
            "required": ["value"]
          }
        }
      ]
    },
    "chatInputConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "const": "user_message"
        }
      }
    },
    "authContextConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "const": "server_context"
        }
      }
    },
    "ragRetrieveConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "knowledge_base_binding_id",
        "index_binding_id",
        "query_state_path",
        "retrieval"
      ],
      "properties": {
        "knowledge_base_binding_id": {
          "$ref": "#/$defs/identifier"
        },
        "index_binding_id": {
          "$ref": "#/$defs/identifier"
        },
        "query_state_path": {
          "$ref": "#/$defs/statePath"
        },
        "retrieval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "config_version",
            "strategy",
            "dense_top_k",
            "sparse_top_k",
            "fusion_top_k",
            "rerank_top_k",
            "context_top_k"
          ],
          "properties": {
            "config_version": {
              "$ref": "#/$defs/version"
            },
            "strategy": {
              "enum": ["dense", "sparse", "hybrid"]
            },
            "dense_top_k": {
              "type": "integer",
              "minimum": 0
            },
            "sparse_top_k": {
              "type": "integer",
              "minimum": 0
            },
            "fusion_top_k": {
              "type": "integer",
              "minimum": 1
            },
            "rerank_top_k": {
              "type": "integer",
              "minimum": 1
            },
            "context_top_k": {
              "type": "integer",
              "minimum": 1
            },
            "ef_search": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "answerWithCitationConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_binding_id", "prompt_binding_id", "max_output_tokens"],
      "properties": {
        "model_binding_id": {
          "$ref": "#/$defs/identifier"
        },
        "prompt_binding_id": {
          "$ref": "#/$defs/identifier"
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "answerGateConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks", "on_fail"],
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["groundedness", "citation", "policy", "format", "sensitive_content"]
          }
        },
        "on_fail": {
          "enum": ["abstain", "clarify", "human_escalation"]
        }
      }
    },
    "chatOutputConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format"],
      "properties": {
        "format": {
          "const": "answer_envelope"
        }
      }
    },
    "branchConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cases", "default_port"],
      "properties": {
        "cases": {
          "type": "array",
          "minItems": 1,
          "description": "Evaluate cases in declaration order; the first matching predicate wins. Semantic validation rejects identical predicates.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["when", "port"],
            "properties": {
              "when": {
                "$ref": "#/$defs/predicate"
              },
              "port": {
                "$ref": "#/$defs/identifier"
              }
            }
          }
        },
        "default_port": {
          "const": "default"
        }
      }
    },
    "loopConfig": {
      "description": "The loop node must expose exactly next and done output ports; semantic validation enforces bounded back-edges.",
      "type": "object",
      "additionalProperties": false,
      "required": ["until", "max_iterations", "max_duration_ms"],
      "properties": {
        "until": {
          "$ref": "#/$defs/predicate"
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1
        },
        "max_duration_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "toolCallConfig": {
      "description": "For write or high-risk bindings, semantic validation requires approval_node_id and an approved graph path before invocation.",
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_id", "input_state_path", "timeout_ms", "max_retries"],
      "properties": {
        "binding_id": {
          "$ref": "#/$defs/identifier"
        },
        "input_state_path": {
          "$ref": "#/$defs/statePath"
        },
        "approval_node_id": {
          "$ref": "#/$defs/identifier"
        },
        "idempotency_key_state_path": {
          "$ref": "#/$defs/statePath"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "humanApprovalConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent_id", "approval_policy_binding_id", "request_state_path", "timeout_ms"],
      "properties": {
        "intent_id": {
          "$ref": "#/$defs/identifier"
        },
        "approval_policy_binding_id": {
          "$ref": "#/$defs/identifier"
        },
        "request_state_path": {
          "$ref": "#/$defs/statePath"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "subgraphConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_id", "input_state_path", "max_steps"],
      "properties": {
        "binding_id": {
          "$ref": "#/$defs/identifier"
        },
        "input_state_path": {
          "$ref": "#/$defs/statePath"
        },
        "max_steps": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
